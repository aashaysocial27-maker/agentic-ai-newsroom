{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:provider/:path*", "destination": "/api/proxy?__provider=:provider&__path=:path*" }
  ]
}
